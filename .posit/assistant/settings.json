{
  "sandbox": {
    "enabled": false
  },
  "permission": {
    "edit": {
      "*.md": "allow",
      "*.R": "allow",
      "*/DESCRIPTION": "allow",
      "*/.gitignore": "allow",
      "*/.Rbuildignore": "allow",
      "*.yml": "allow",
      "*.qmd": "allow"
    },
    "executeCode": {
      "*": "allow"
    },
    "bash": {
      "air *": "allow",
      "echo *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git ls-files *": "allow",
      "git rev-parse *": "allow",
      "git remote *": "allow",
      "git check-ignore *": "allow",
      "find *": "allow",
      "sed *": "allow",
      "ls *": "allow",
      "git checkout *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "awk *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "tree *": "allow",
      "less *": "allow",
      "more *": "allow",
      "diff *": "allow",
      "cut *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "column *": "allow",
      "du *": "allow",
      "pwd": "allow",
      "which *": "allow"
    },
    "webfetch": {
      "https://posit-dev.github.io/*": "allow",
      "https://raw.githubusercontent.com/*": "allow"
    }
  }
}
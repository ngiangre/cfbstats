#!/usr/bin/env sh
# Pre-commit hook: mirror the CI format-check job (air format . --check) so
# formatting issues are caught before pushing rather than in CI.
#
# Enable once per clone (the hook path is not tracked by git):
#   git config core.hooksPath .githooks
#
# Requires the `air` formatter (https://posit-dev.github.io/air/). If air is not
# on PATH the check is skipped with a warning, so commits are never hard-blocked
# on a machine without air installed — CI still enforces formatting.

if ! command -v air >/dev/null 2>&1; then
  echo "pre-commit: 'air' not on PATH; skipping format check (CI still enforces it)." >&2
  exit 0
fi

if ! air format . --check; then
  echo >&2
  echo "pre-commit: air formatting check failed." >&2
  echo "  Fix with: air format ." >&2
  echo "  Then re-stage the changes and commit again." >&2
  exit 1
fi
